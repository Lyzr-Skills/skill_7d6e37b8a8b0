  "properties": {
    "hypothesis": { "type": "string" },
    "variable": { "type": "string" },
    "control": { "type": "string" },
    "variant": { "type": "string" },
    "target": { "type": "string" },
    "metric": { "type": "string" },
    "duration": { "type": "string" },
    "result": { "type": ["string", "null"] },
