{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeasurementFramework",
  "type": "object",
  "required": ["north_star_metric", "primary_metric", "secondary_metrics", "diagnostic_metrics", "guardrail_metrics"],
  "properties": {
    "north_star_metric": { "$ref": "#/definitions/metric" },
    "primary_metric": { "$ref": "#/definitions/metric" },
    "secondary_metrics": { "type": "array", "items": { "$ref": "#/definitions/metric" } },
    "diagnostic_metrics": { "type": "array", "items": { "$ref": "#/definitions/metric" } },
    "guardrail_metrics": { "type": "array", "items": { "$ref": "#/definitions/metric" } }
  },
  "definitions": {
    "metric": {
      "type": "object",
      "required": ["name", "metric_type", "class", "target", "baseline"],
      "properties": {
        "name": { "type": "string" },
        "metric_type": {
          "type": "string",
          "enum": ["North Star", "Primary Success", "Secondary", "Diagnostic", "Guardrail"]
        },
        "class": {
          "type": "string",
          "enum": ["Output", "Outcome"]
        },
        "target": { "type": ["number", "string"] },
        "baseline": { "type": ["number", "string"] },
        "actual": { "type": ["number", "string", "null"] },
        "attribution": { "type": ["string", "null"] }
      }
    }
  }
}
