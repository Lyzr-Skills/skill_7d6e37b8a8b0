{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Campaign",
  "type": "object",
  "required": ["identity", "references", "strategy", "audience", "channel", "messaging", "assets", "CTA", "measurement", "execution"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["campaign_id", "name", "status", "version", "created_at", "updated_at"],
      "properties": {
        "campaign_id": { "type": "string" },
        "name": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["DRAFT", "PLANNED", "IN_PROGRESS", "QA", "READY", "LIVE", "OPTIMIZING", "COMPLETED", "PAUSED", "BLOCKED", "CANCELLED"]
        },
        "version": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "approved_at": { "type": ["string", "null"] },
        "completed_at": { "type": ["string", "null"] }
      }
    },
    "references": {
      "type": "object",
      "required": ["strategy_reference", "positioning_reference", "icp_reference", "messaging_reference"],
      "properties": {
        "strategy_reference": { "type": "string" },
        "positioning_reference": { "type": "string" },
        "icp_reference": { "type": "string" },
        "messaging_reference": { "type": "string" }
      }
    },
    "strategy": {
      "type": "object",
      "required": ["objective", "strategic_goal"],
      "properties": {
        "objective": { "type": "string" },
        "strategic_goal": { "type": "string" }
      }
    },
    "audience": {
      "type": "object",
      "required": ["ICP", "persona", "segment", "inclusion_criteria", "exclusion_criteria"],
      "properties": {
        "ICP": { "type": "string" },
        "persona": { "type": "string" },
        "segment": { "type": "string" },
        "inclusion_criteria": { "type": "array", "items": { "type": "string" } },
        "exclusion_criteria": { "type": "array", "items": { "type": "string" } }
      }
    },
    "channel": {
      "type": "object",
      "required": ["primary", "secondary", "distribution_method", "why", "expected_role"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "distribution_method": { "type": "string" },
        "why": { "type": "string" },
        "expected_role": { "type": "string" }
      }
    },
    "messaging": {
      "type": "object",
      "required": ["core_message", "pain", "outcome", "differentiator", "proof"],
      "properties": {
        "core_message": { "type": "string" },
        "pain": { "type": "string" },
        "outcome": { "type": "string" },
        "differentiator": { "type": "string" },
        "proof": { "type": "string" }
      }
    },
    "assets": {
      "type": "object",
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "$ref": "campaign-asset.schema.json" }
        },
        "optional": {
          "type": "array",
          "items": { "$ref": "campaign-asset.schema.json" }
        }
      }
    },
    "CTA": {
      "type": "object",
      "required": ["primary", "destination", "conversion_event"],
      "properties": {
        "primary": { "type": "string" },
        "destination": { "type": "string" },
        "conversion_event": { "type": "string" }
      }
    },
    "measurement": {
      "type": "object",
      "required": ["north_star_metric", "primary_metric", "secondary_metrics", "diagnostic_metrics", "guardrail_metrics"],
      "properties": {
        "north_star_metric": { "$ref": "measurement.schema.json#/definitions/metric" },
        "primary_metric": { "$ref": "measurement.schema.json#/definitions/metric" },
        "secondary_metrics": { "type": "array", "items": { "$ref": "measurement.schema.json#/definitions/metric" } },
        "diagnostic_metrics": { "type": "array", "items": { "$ref": "measurement.schema.json#/definitions/metric" } },
        "guardrail_metrics": { "type": "array", "items": { "$ref": "measurement.schema.json#/definitions/metric" } }
      }
    },
    "execution": {
      "type": "object",
      "required": ["tasks", "owners", "dependencies", "launch_date", "launch_status"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": { "$ref": "campaign-task.schema.json" }
        },
        "owners": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "launch_date": { "type": "string" },
        "launch_status": { "type": "string" }
      }
    },
    "results": {
      "type": "object",
      "properties": {
        "performance": { "type": "object" },
        "learnings": { "type": "array", "items": { "type": "string" } },
        "recommendations": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
